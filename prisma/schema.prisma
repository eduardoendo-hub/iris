generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PRODUCT — uma LP/produto monitorado pelo IRIS
// ============================================================
model Product {
  id   String @id @default(cuid())
  slug String @unique
  name String
  url  String

  // External IDs
  ga4PropertyId       String
  googleAdsCustomerId String?
  metaAdAccountId     String?
  symplaEventId       String?
  gscSiteUrl          String?

  // UTM
  utmCampaignPrefix String

  // Meta
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots Snapshot[]
  insights  Insight[]

  @@index([slug])
}

// ============================================================
// CAMPAIGN — campanha de mkt configuravel via /admin
// ============================================================
// Cada produto pode ter N campanhas, mas apenas 1 ATIVA por vez.
// Constraint enforce via partial unique index (Postgres):
//   CREATE UNIQUE INDEX ... ON Campaign(productSlug) WHERE isActive = true
// Define metas + investimentos pro cockpit IRIS calcular ROAS real
// (mídia + custos de produção).
model Campaign {
  id              String   @id @default(cuid())
  slug            String   @unique  // ex: "claude-pro-mai-2026"
  productSlug     String              // bate com Product.slug
  name            String              // ex: "Lançamento Claude Pro Maio/2026"

  startDate       DateTime            // dia 1 da campanha (SP midnight)
  endDate         DateTime            // último dia de matrículas (SP midnight)

  // INVESTIMENTOS (R$, opcionais — preenche conforme tem dado)
  mediaBudget         Decimal? @db.Decimal(15, 2)  // Meta + Google paid
  productionCostLP    Decimal? @db.Decimal(15, 2)  // Custo da LP
  productionCostAds   Decimal? @db.Decimal(15, 2)  // Custo das peças/criativos
  productionCostOther Decimal? @db.Decimal(15, 2)  // Outros (consultorias, etc)

  // METAS (opcionais)
  goalEnrollments     Int?
  goalRevenue         Decimal? @db.Decimal(15, 2)
  goalCac             Decimal? @db.Decimal(15, 2)
  goalRoas            Decimal? @db.Decimal(8, 2)   // ex: 5.00 = 5x
  goalCpl             Decimal? @db.Decimal(15, 2)

  // Plano de marketing (texto grande, opcional)
  marketingPlan         String?  @db.Text
  marketingPlanFilename String?

  isActive        Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  @@index([productSlug, isActive])
  @@index([startDate])
}

// ============================================================
// ACESSO — emails individuais e dominios autorizados a logar
// ============================================================
// Antes: hardcoded em env ALLOWED_EMAIL_DOMAINS / ALLOWED_EMAIL_ADDRESSES.
// Agora: armazenado no DB, gerenciado via /admin/access.
// Auth.ts checa esses + envs (envs continuam funcionando como fallback)
model AllowedEmail {
  id            String   @id @default(cuid())
  email         String   @unique
  note          String?
  addedAt       DateTime @default(now())
  addedByUserId String?
}

model AllowedDomain {
  id            String   @id @default(cuid())
  domain        String   @unique
  note          String?
  addedAt       DateTime @default(now())
  addedByUserId String?
}

// ============================================================
// SNAPSHOT — foto agregada de métricas num bucket de tempo
// ============================================================
model Snapshot {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  bucket      Bucket
  startsAt    DateTime
  source      Source
  channel     String?
  ctaPosition String?

  sessions    Int?
  users       Int?
  pageviews   Int?
  cost        Decimal? @db.Decimal(10, 2)
  clicks      Int?
  ctaClicks   Int?
  impressions Int?
  conversions Int?
  ctr         Decimal? @db.Decimal(5, 4)
  cpc         Decimal? @db.Decimal(8, 2)
  cpm         Decimal? @db.Decimal(8, 2)

  rawJson Json

  createdAt DateTime @default(now())

  @@unique([productId, bucket, startsAt, source, channel, ctaPosition])
  @@index([productId, startsAt, source])
}

enum Bucket {
  HOUR
  DAY
}

enum Source {
  GA4
  GOOGLE_ADS
  META_ADS
  SYMPLA
  GSC
  RD_CRM
}

// ============================================================
// INSIGHT — output da camada AI
// ============================================================
model Insight {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  generatedAt    DateTime @default(now())
  severity       Severity
  category       Category
  title          String
  body           String   @db.Text
  recommendation String?  @db.Text

  metricsRefs Json
  contextHash String @unique

  acknowledgedAt DateTime?
  acknowledgedBy String?

  pushSentAt  DateTime?
  emailSentAt DateTime?

  @@index([productId, generatedAt])
}

enum Severity {
  INFO
  WARN
  HIGH
  CRITICAL
}

enum Category {
  ANOMALY
  OPPORTUNITY
  SUMMARY
  FORECAST
}

// ============================================================
// LEAD — captura de leads recebida via webhook do integracao-rd
// (endpoint: POST /api/webhook/rd)
// Cada lead representa um envio de formulário "Falar com especialista"
// ou clique em WhatsApp em qualquer LP cadastrada como Product.
// ============================================================
model Lead {
  id           String    @id @default(cuid())
  productSlug  String // "claude-pro" — bate com Product.slug
  campaignSlug String // "claude-pro-maio-2026"
  eventType    LeadEvent // FORM_SUBMIT | WHATSAPP_CLICK

  name   String?
  email  String?
  phone  String?
  perfil String? // "Gestora", "Analista", etc.

  // UTMs
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  sourcePage String?

  // Refs do RD CRM (preenchidos quando integracao-rd retorna sucesso)
  rdCrmContactId String?
  rdCrmDealId    String?
  rdCrmStatus    String? // "created" | "updated" | "skipped"

  // Status do funil comercial
  status LeadStatus @default(NEW)

  rawJson    Json // payload bruto do webhook
  capturedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productSlug, capturedAt])
  @@index([campaignSlug])
  @@index([rdCrmDealId])
}

enum LeadEvent {
  FORM_SUBMIT
  WHATSAPP_CLICK
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CHECKOUT_STARTED
  WON
  LOST
}

// ============================================================
// SALE — vendas confirmadas (registradas via webhook Engaged
// ou manualmente quando vem de outro canal).
// ============================================================
model Sale {
  id          String     @id @default(cuid())
  productSlug String     // "claude-pro"
  source      SaleSource @default(DIRETA)

  customerName  String
  customerEmail String?
  customerPhone String?

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("BRL")

  // External refs (quando vem do Engaged ou outro gateway)
  externalId  String? // ID do pedido no sistema de origem
  externalRef String? // payment_id, invoice, etc.

  notes String? @db.Text

  saleDate  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([productSlug, saleDate])
  @@index([source])
}

enum SaleSource {
  ENGAGED   // checkout do Engaged (webhook Purchase, futuro)
  DIRETA    // venda direta (manual: checkout/transferencia/outro)
  CONSULTOR // venda fechada por consultor (manual)
  MANUAL    // legado — mantido pra compat (nao usar mais em vendas novas)
  OTHER     // outra fonte (Hotmart, etc.)
}

// ============================================================
// METRIC SAMPLE — sample agregado de qualquer fonte de ingest
// (GA4 Data API, Meta Ads Insights, Google Ads GAQL, Engaged stats, etc.)
//
// Modelo unico generico: cada linha eh um (productSlug, source, metric,
// bucket, startsAt) com valor numerico. Os crons fazem upsert idempotente
// — se rodam de novo no mesmo bucket, sobrescrevem.
//
// Exemplos:
//   GA4   sessions      DAY  2026-05-11  1240
//   GA4   click_compra  DAY  2026-05-11    87
//   GA4   click_whats   DAY  2026-05-11    45
//   META  spend         DAY  2026-05-11   650.00
// ============================================================
model MetricSample {
  id          String       @id @default(cuid())
  productSlug String       // bate com Product.slug ("claude-pro")
  source      MetricSource // GA4 | META_ADS | GOOGLE_ADS | ENGAGED | RD_CRM | MANUAL
  metric      String       // nome do evento ou metrica ("sessions", "click_compra", "spend", etc.)
  bucket      Bucket       // HOUR | DAY (reusa enum existente)
  startsAt    DateTime     // inicio do bucket
  value       Decimal      @db.Decimal(15, 2)
  unit        String?      // "count" | "BRL" | "ratio" — opcional, ajuda formatacao
  meta        Json?        // breakdowns adicionais (campaign_id, channel, etc.)
  createdAt   DateTime     @default(now())

  @@unique([productSlug, source, metric, bucket, startsAt])
  @@index([productSlug, metric, startsAt])
  @@index([source, startsAt])
}

enum MetricSource {
  GA4
  META_ADS
  GOOGLE_ADS
  ENGAGED
  RD_CRM
  MANUAL
}

// ============================================================
// WEBHOOK LOG — registra TODOS os webhooks que chegam no IRIS
// (mesmo os que retornam ignored/error). Util pra debugar quando
// integracao com Engaged/RD/outros parece nao estar funcionando.
// Retem ultimos N dias automaticamente via cron de cleanup.
// ============================================================
model WebhookLog {
  id          String   @id @default(cuid())
  source      String   // "engaged" | "rd_crm" | etc
  receivedAt  DateTime @default(now())
  // Request data
  headers     Json     // headers HTTP relevantes (sem authorization completa)
  rawBody     String   @db.Text // body como recebido
  // Response
  statusCode  Int      // HTTP status retornado
  resultJson  Json?    // resposta enviada ao caller
  // Outcome
  outcome     String   // "created" | "updated" | "ignored" | "auth_failed" | "validation_failed" | "error"
  reason      String?  // detalhe (ex: "status_not_paid", "invalid_signature")
  saleId      String?  // se criou Sale, ID dela
  externalId  String?  // ID externo (order_id, etc) pra busca rapida

  @@index([source, receivedAt])
  @@index([outcome])
  @@index([externalId])
}

// ============================================================
// ENGAGED PURCHASE — rastreia todos os estados de compra Engaged
// ============================================================
// Antes o webhook so processava purchase.paid (criava Sale). Eventos
// intermediarios (lead_captured, waiting_payment, refused, expired,
// canceled) eram ignorados. Agora cada externalId de compra Engaged
// tem 1 linha aqui, com status atual. Sales (PAID) sao criadas em
// paralelo. Quando vira PAID, continua aqui mas a UI filtra pra
// mostrar so nao-PAID em "Leads Engaged".
model EngagedPurchase {
  id              String   @id @default(cuid())
  productSlug     String
  externalId      String   // _id da purchase no Engaged
  status          String   // DRAFT|WAITING_PAYMENT|CANCELED|REFUSED|EXPIRED|PAID
  lastEventType   String   // ultimo eventType recebido
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  amount          Decimal? @db.Decimal(15, 2)
  currency        String?
  // eventAt = quando o EVENTO aconteceu no Engaged (extraido do payload).
  // Use no UI pra "Data" — bate com a UX do user que ve em outras telas.
  // lastUpdatedAt eh auto-managed (toda gravacao no DB atualiza) — serve
  // pra debug/audit, NAO pra display.
  eventAt         DateTime @default(now())
  firstSeenAt     DateTime @default(now())
  lastUpdatedAt   DateTime @updatedAt
  saleId          String?  // FK soft pra Sale quando virou PAID

  @@unique([productSlug, externalId])
  @@index([productSlug, status])
  @@index([eventAt])
}

// ============================================================
// DAILY INSIGHT — análise estratégica diária gerada pela LLM
// ============================================================
// Agente roda 1x por dia (05:00 SP) por (produto, campanha), analisa
// dados do dia anterior, gera headline + summary + recommendations.
// Snapshot das métricas que alimentaram a análise vai em JSON pra
// rastreabilidade (qual estado virou qual conclusão).
model DailyInsight {
  id              String   @id @default(cuid())
  productSlug     String              // "claude-pro"
  campaignSlug    String   @default("") // "" = analise produto-wide (nao null pq Prisma nao aceita nullable em compound unique)
  analysisDate    DateTime            // dia analisado (midnight SP UTC = 03:00 UTC)
  generatedAt     DateTime @default(now())

  // Output da LLM
  headline        String              // titulo curto (1 linha)
  summary         String   @db.Text   // analise narrativa (3-5 linhas markdown)
  recommendations Json                // [{priority:int, action:str, expected_impact:str}]
  severity        String              // INFO | WARN | HIGH | CRITICAL

  // Dados de entrada (auditoria)
  metricsSnapshot Json                // pacote completo enviado ao prompt

  // Metadata
  model           String              // ex: "claude-opus-4-7"
  tokensIn        Int?
  tokensOut       Int?
  cachedTokensRead Int?               // tokens lidos do cache (~0.1x cost)
  promptVersion   String              // ex: "v1" — pra re-rodar quando trocar prompt

  @@unique([productSlug, campaignSlug, analysisDate])
  @@index([productSlug, analysisDate])
  @@index([generatedAt])
}

// ============================================================
// VISIT EVENTS — eventos granulares da LP com UTMs
// ============================================================
// MetricSample agrega contadores por dia (rapido pro cockpit), mas perde
// dimensoes pra analise por canal. VisitEvent guarda CADA evento da LP
// individualmente com UTMs/referrer pra responder "quantas visitas vieram
// do RD Station?" sem rodar SQL no JSON.
// Append-only: nunca atualizar, so insert. Retencao definida por job
// separado (90 dias deve dar pra qualquer analise).
model VisitEvent {
  id           String   @id @default(cuid())
  productSlug  String   // "claude-pro"
  eventName    String   // lp_view | click_compra | click_consultor | click_whats | lead_form
  campaignSlug String?  // slug interno IRIS (ex: claude-pro-maio-2026)
  pageUrl      String?
  utmSource    String?  // "google", "meta", "rd-station", "direct"
  utmMedium    String?  // "cpc", "email", "social", "organic"
  utmCampaign  String?  // valor do utm_campaign na URL
  utmContent   String?
  utmTerm      String?
  referrer     String?  // document.referrer (50 chars)
  value        Decimal? @db.Decimal(15, 2)
  currency     String?
  ts           DateTime
  createdAt    DateTime @default(now())

  @@index([productSlug, eventName, ts])
  @@index([productSlug, utmSource, utmMedium, ts])
  @@index([productSlug, ts])
}

// ============================================================
// AUTH — NextAuth (Auth.js v5) tables
// ============================================================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  role          Role      @default(VIEWER)

  notifyByEmail    Boolean @default(true)
  notifyByWebPush  Boolean @default(true)
  notifyByWhatsApp Boolean @default(false)
  whatsappNumber   String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  accounts          Account[]
  sessions          Session[]
  pushSubscriptions PushSubscription[]
}

enum Role {
  VIEWER
  OPERATOR
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// PUSH — Web Push subscriptions
// ============================================================
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  userAgent String?
  createdAt DateTime @default(now())
  lastUsed  DateTime @default(now())

  @@index([userId])
}

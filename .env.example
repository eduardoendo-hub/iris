# ============================================================
# IRIS — variáveis de ambiente
# Revisado em 2026-08-31 contra o código (todas as `process.env.*` usadas).
# Copie para .env e preencha. Em produção, tudo vive no Coolify.
# ============================================================

# ── Banco ────────────────────────────────────────────────────
DATABASE_URL="postgresql://iris:iris@localhost:5432/iris"

# ── Autenticação (Auth.js v5) ────────────────────────────────
# O código aceita os dois nomes: AUTH_* (v5) OU os NEXTAUTH_*/GOOGLE_* legados.
# Em setup novo, use os AUTH_*.
AUTH_URL="http://localhost:3000"
AUTH_SECRET=""                    # openssl rand -hex 32
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Legados equivalentes (mantidos por compatibilidade):
# NEXTAUTH_URL / NEXTAUTH_SECRET / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET

# Quem pode logar. Domínio inteiro e/ou e-mails avulsos (separados por vírgula).
ALLOWED_EMAIL_DOMAINS="impacta.com.br,technowhub.ai"
ALLOWED_EMAIL_ADDRESSES=""

# Magic-link de login (Auth.js Resend provider).
# EMAIL_FROM precisa ser de um domínio VERIFICADO no Resend.
RESEND_API_KEY=""
EMAIL_FROM="iris@technowhub.ai"

# ⚠️ Bypass TOTAL de autenticação — só em dev/preview.
# Em produção deve estar ausente ou "false". Ver docs/SECURITY.md.
IRIS_PUBLIC_PREVIEW="false"

# ── Segredos de acesso a máquina ─────────────────────────────
# Header X-Admin-Secret nos /api/admin/*  (e o migrate aceita os dois).
IRIS_WEBHOOK_SECRET=""
# Header X-Cron-Secret em todas as rotas /api/cron/*.
CRON_SECRET=""

# ── IA ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ── GA4 (Data API) ───────────────────────────────────────────
GA4_PROPERTY_ID=""
GA4_SERVICE_ACCOUNT_JSON=""       # JSON da service account, em uma linha

# ── Google Ads ───────────────────────────────────────────────
# Acesso via REST v23 com fetch nativo (lib/ingest/google-rest.ts) — a lib
# google-ads-api quebra no container, não a reintroduza. Ver CLAUDE.md.
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""   # MCC
GOOGLE_ADS_CUSTOMER_ID=""         # conta que veicula

# ── Meta (Marketing API) ─────────────────────────────────────
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""             # com ou sem o prefixo act_

# ── Webhook do Engaged (vendas) ──────────────────────────────
# HMAC-SHA256 do body em X-Engaged-Signature. Sem o secret, o webhook aceita
# sem validar (modo dev) — NÃO deixe assim em produção.
ENGAGED_WEBHOOK_SECRET=""
ENGAGED_WEBHOOK_TOKEN=""

# ── Integrações externas ─────────────────────────────────────
# Microserviço que cria Lead+Deal no RD CRM (o mesmo que as LPs chamam).
INTEGRACAO_RD_URL="https://rd.technowhub.ai"
# API da Impacta — usada na reconciliação de matrículas.
IMPACTA_API_URL=""

# ── Recuperação de checkout abandonado (WhatsApp via ChatPro) ─
CHATPRO_CHAT_URL=""
CHATPRO_CHAT_TOKEN=""
CHATPRO_CHAT_INSTANCE_ID=""
CHATPRO_CHAT_PROVIDER=""
CHATPRO_TEMPLATE_URL=""
# Trava de segurança: sem RECOVERY_SEND=true o cron só faz dry-run (não envia).
RECOVERY_SEND="false"
RECOVERY_MAX_PER_RUN=""
RECOVERY_MAX_AGE_DAYS=""
RECOVERY_VOUCHER_CODE=""

# ============================================================
# Removidas nesta revisão por não existirem no código:
#   REDIS_URL, SYMPLA_API_KEY, VAPID_* (Web Push), META_APP_SECRET,
#   GOOGLE_APPLICATION_CREDENTIALS_JSON (o nome correto é GA4_SERVICE_ACCOUNT_JSON).
# ============================================================
